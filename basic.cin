    // 9. String Operations
    println("9. String Operations Demo")
    println("-------------------------")
    string_operations()
    println("")
    
    // 10. Temperature Processing
    println("10. Temperature Processing")
    println("-------------------------")
    process_temperatures()
    println("")
    
    // 11. Shapes Demo
    println("11. Shapes Demo")
    println("---------------")
    shapes_demo()
    println("")
    
    // 12. Student Management
    println("12. Student Management System")
    println("----------------------------")
    student_demo()
    println("")
    
    // 13. CPU Operations
    println("13. CPU Instruction Integration")
    println("-----------------------------")
    cpu_operations_example()
    println("")
    
    // 14. Global Counter
    println("14. Global Variable Demo")
    println("------------------------")
    global_counter = 0
    for (int i = 0; i < 5; i = i + 1) {
        global_counter = global_counter + i
        println("Iteration " + i + ": " + global_counter)
    }
    println("")
    
    // 15. Circle Area
    println("15. Circle Area Calculator")
    println("--------------------------")
    float radius = 5.0
    float area = calculate_circle_area(radius)
    println("Circle with radius " + radius + " has area: " + area)
    println("")
    
    // 16. Nested Loops with Break
    println("16. Nested Loops with Break")
    println("--------------------------")
    for (int i = 0; i < 5; i = i + 1) {
        for (int j = 0; j < 5; j = j + 1) {
            print("(" + i + "," + j + ") ")
            if (i == 2 && j == 2) {
                println("")
                println("Break at (2,2)!")
                break
            }
        }
        println("")
        if (i == 2) {
            break
        }
    }
    println("")
    
    // 17. Sum of Squares
    println("17. Sum of Squares (1^2 + 2^2 + ... + n^2)")
    println("----------------------------------------")
    int n = 10
    int sum_squares = 0
    for (int i = 1; i <= n; i = i + 1) {
        sum_squares = sum_squares + pow(i, 2)
    }
    println("Sum of squares up to " + n + " = " + sum_squares)
    println("")
    
    // 18. Check if perfect number
    println("18. Perfect Number Check (28)")
    println("----------------------------")
    int num = 28
    int divisor_sum = 0
    for (int i = 1; i < num; i = i + 1) {
        if (num % i == 0) {
            divisor_sum = divisor_sum + i
        }
    }
    if (divisor_sum == num) {
        println(num + " is a perfect number!")
    } else {
        println(num + " is not a perfect number")
    }
    println("")
    
    println("========================================")
    println("  DEMO COMPLETED SUCCESSFULLY!")
    println("  Total program length: ~400 lines")
    println("========================================")
    println("")
    println("Features demonstrated:")
    println("  - Functions and recursion")
    println("  - Structs and arrays")
    println("  - 2D arrays and matrix operations")
    println("  - String operations")
    println("  - Built-in math functions")
    println("  - Random number generation")
    println("  - CPU instruction integration")
    println("  - Sorting and searching")
    println("  - Nested loops and control flow")
    println("  - Global and local variables")
    println("  - Type system support")
    println("")
    
    return 0
}