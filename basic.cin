    // 5. Matrix Multiplication
    println("5. Matrix Multiplication (2x2)")
    println("-----------------------------")
    int[][] mat1 = {{1, 2}, {3, 4}}
    int[][] mat2 = {{5, 6}, {7, 8}}
    int[][] result = matrix_multiply(mat1, mat2, 2)
    println("[[1,2] * [[5,6]  =  [[19,22]")
    println(" [3,4]]   [7,8]]     [43,50]]")
    println("")
    
    // 6. Math Functions
    println("6. Math Functions Demo")
    println("----------------------")
    math_demo()
